# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed-forever assets. Artwork never changes under the same name.
#
# The share card deliberately lives outside this folder, in /assets/social/.
# Pages merges every matching rule instead of letting a more specific one
# win, so a second block for one file here produces a header with two
# conflicting max-age values. Keeping it off this path is the way to give it
# a different cache policy.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Replaced under the same name whenever the branding changes, so it has to
# revalidate or Discord and Google keep showing last year's card.
/assets/social/*
  Cache-Control: public, max-age=3600, must-revalidate

# CSS and JS do change, so keep them fresh but cheap to revalidate.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/i18n/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/quiz/*
  Cache-Control: public, max-age=3600, must-revalidate

# The item database is rebuilt from the sheets, not on every deploy, and it is
# the biggest thing the site downloads.
/assets/data/*
  Cache-Control: public, max-age=86400, must-revalidate
