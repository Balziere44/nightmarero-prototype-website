# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed-forever assets. Images and fonts never change under the same name.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# The share card is the one image that does get replaced under the same
# name. A year of immutable caching would leave Discord and Google showing
# the old artwork long after it changed, so this one revalidates.
/assets/img/og-cover.jpg
  Cache-Control: public, max-age=3600, must-revalidate

# CSS and JS do change, so keep them fresh but cheap to revalidate.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/i18n/*
  Cache-Control: public, max-age=3600, must-revalidate
